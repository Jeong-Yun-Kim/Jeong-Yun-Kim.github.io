---
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import projects from '../../data/projects.json';
import type { Project } from '../../data/types';
import { archive, studies } from '../../data/archive';
---
<Base title="프로젝트 아카이브" description="로봇 제어·비전·자율주행·Backend 프로젝트와 개발 기록.">
  <div class="container page-heading"><p class="eyebrow">PROJECT ARCHIVE</p><h1>프로젝트</h1><p class="page-lead">구현 내용과 검증 범위를 중심으로 정리한 개발 기록.</p><nav class="anchor-nav" aria-label="프로젝트 분류"><a href="#selected">대표 프로젝트</a><a href="#archive">개발 아카이브</a><a href="#research">기획·학습</a></nav></div>
  <section class="container section compact-top" id="selected"><h2 class="sr-only">대표 프로젝트</h2>{(projects as Project[]).filter(p=>p.featured).map((p,i)=><ProjectRow project={p} index={i}/>)}</section>
  <section class="container section" id="archive"><div class="section-heading"><div><p class="eyebrow">MORE WORK</p><h2>개발 아카이브</h2></div></div><div class="archive-grid">{archive.map(p=><article class="archive-item"><p class="eyebrow">{p.category}</p><h3>{p.title}</h3><p class="mono small muted">{p.period}</p><p>{p.summary}</p><p class="archive-note">{p.note}</p>{p.href.startsWith('https:') ? <ExternalLink href={p.href}>{p.linkLabel}</ExternalLink> : <a class="text-link" href={p.href}>{p.linkLabel} →</a>}</article>)}</div></section>
  <section class="container section" id="research"><div class="section-heading"><div><p class="eyebrow">PLANNING & STUDY</p><h2>기획·학습</h2></div></div><article class="research-row"><div><p class="mono small muted">2026.10 · 기획 단계</p><h3>리니어 이송 보관대 기반 자동 피킹</h3></div><div><p>Mirobot과 주문 박스를 고정하고 보관대를 이동하는 Double Click 팀 프로젝트. Raspberry Pi의 주문 관리, Arduino의 리니어 모터 제어, QR 확인과 Pick & Place를 연결하는 구조를 정리했습니다.</p><p class="small muted">설계·역할 분담·3주 개발 계획 기록 기준. 완료 프로젝트의 성과로 포함하지 않았습니다.</p></div></article><div class="study-links">{studies.map(s=><div><ExternalLink href={s.url}>{s.title}</ExternalLink><p class="small muted">{s.description}</p></div>)}</div></section>
</Base>

---
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { profile, activities, awards, skills } from '../data/profile';
import projects from '../data/projects.json';
import type { Project } from '../data/types';
const selected = (projects as Project[]).filter(p => p.featured);
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">PORTFOLIO <span>/ 2026</span></p>
      <h1 id="hero-title">김정윤<span class="name-en">Jeong-Yun Kim</span></h1>
      <p class="focus">{profile.focus}</p>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-links"><a class="button" href="#projects">대표 프로젝트 보기 <span aria-hidden="true">↘</span></a><a class="text-link" href="/resume/">이력서 <span aria-hidden="true">→</span></a><ExternalLink href={profile.github}>GitHub</ExternalLink></div>
    </div>
    <aside class="hero-index" aria-label="주요 개발 분야">
      <span class="eyebrow">FOCUS AREAS</span>
      <div><span class="mono">01</span><p>로봇 제어<span>ROS2 · Manipulation · Vision</span></p></div>
      <div><span class="mono">02</span><p>자율주행<span>Simulation · Planning · Evaluation</span></p></div>
      <div><span class="mono">03</span><p>서버 개발<span>API · Data · System Integration</span></p></div>
      <p class="hero-school">충북대학교<br />지능로봇공학과 재학</p>
    </aside>
  </section>
  <section class="section container" id="projects" aria-labelledby="projects-title">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="projects-title">대표 프로젝트 <span class="count">04</span></h2></div><a class="text-link" href="/projects/">전체 프로젝트 <span aria-hidden="true">→</span></a></div>
    <div>{selected.map((p,i) => <ProjectRow project={p} index={i} />)}</div>
  </section>
  <section class="section container split-section" id="experience" aria-labelledby="experience-title">
    <div class="section-heading"><div><p class="eyebrow">EXPERIENCE & ACTIVITIES</p><h2 id="experience-title">경험 및 활동</h2></div></div>
    <div class="timeline">{activities.map(a => <article class="timeline-row"><p class="mono muted">{a.period}</p><div><h3>{a.href ? <a href={a.href}>{a.title}</a> : a.title}</h3><p>{a.description}</p></div></article>)}</div>
  </section>
  <section class="section container split-section" id="awards" aria-labelledby="awards-title">
    <div class="section-heading"><div><p class="eyebrow">AWARDS</p><h2 id="awards-title">수상</h2><p class="section-note">교내 대회 수상 기록</p></div></div>
    <div class="award-list">{awards.map(a => <article class="award-row"><div><p class="award-category">{a.scope}{a.year && ` · ${a.year}`}</p><h3>{a.name}</h3></div><p class="award-result">{a.result}</p></article>)}<p class="small muted">교외 멘토링 본선 진출은 경험 및 활동에 구분해 기재했습니다.</p></div>
  </section>
  <section class="section container" id="skills" aria-labelledby="skills-title">
    <div class="section-heading"><div><p class="eyebrow">TECHNICAL SKILLS</p><h2 id="skills-title">기술</h2></div><p class="section-note">실제 구현에 사용한 기술과 적용 범위</p></div>
    <div class="skill-grid">{skills.map(s => <article class="skill-item"><h3>{s.category}</h3><p class="skill-names">{s.names.join(' · ')}</p><p>{s.evidence}</p><a class="small text-link" href={s.href}>관련 프로젝트 <span aria-hidden="true">→</span></a></article>)}</div>
  </section>
  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container contact-inner"><div><p class="eyebrow">CONTACT</p><h2 id="contact-title">연락처</h2><p>프로젝트와 개발 기록은 GitHub에서 확인할 수 있습니다.</p></div><div class="contact-links"><a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a><div class="link-row"><ExternalLink href={profile.github}>GitHub</ExternalLink><a href="/resume/">이력서 보기 →</a></div></div></div></section>
</Base>

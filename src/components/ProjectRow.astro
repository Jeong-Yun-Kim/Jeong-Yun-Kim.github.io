---
import type { Project } from '../data/types';
import ExternalLink from './ExternalLink.astro';
interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
const github = p.links.find(link => link.label.startsWith('GitHub'));
---
<article class="project-row">
  <div class="project-copy">
    <div class="project-kicker"><span class="mono">{String(index + 1).padStart(2,'0')}</span><span>{p.category}</span></div>
    <h3><a href={`/projects/${p.slug}/`}>{p.title}</a></h3>
    <p class="project-summary">{p.summary}</p>
    <dl class="project-meta"><div><dt>기간</dt><dd>{p.period}</dd></div><div><dt>역할</dt><dd>{p.role}</dd></div></dl>
    <ul class="tags" aria-label="주요 기술">{p.technologies.map(t => <li>{t}</li>)}</ul>
    <p class="project-result">{p.highlight}</p>
    <div class="link-row"><a class="text-link" href={`/projects/${p.slug}/`}>{p.title} 상세 보기 <span aria-hidden="true">→</span></a>{github && <ExternalLink href={github.url}>GitHub</ExternalLink>}</div>
  </div>
  <figure class="project-figure">
    <img src={p.image} alt={p.imageAlt} width="960" height="540" loading="lazy" decoding="async" />
    <figcaption>{p.imageCaption}</figcaption>
  </figure>
</article>

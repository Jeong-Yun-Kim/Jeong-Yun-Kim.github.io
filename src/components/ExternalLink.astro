---
interface Props { href: string; class?: string; label?: string }
const { href, class: className, label } = Astro.props;
---
<a href={href} class={className} target="_blank" rel="noopener noreferrer" aria-label={label}><slot /><span class="external-arrow" aria-hidden="true">↗</span><span class="sr-only"> (새 탭)</span></a>
